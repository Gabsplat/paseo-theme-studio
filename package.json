{
  "name": "paseo-theme-studio",
  "private": true,
  "version": "0.5.0",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "node scripts/ensure-generated-registry.mjs && node scripts/build-export-assets.mjs && tsc --noEmit",
    "test": "tsx --test shared/*.test.ts server/*.test.ts client/*.test.ts",
    "build:export": "node scripts/build-export-assets.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json}\"",
    "postinstall": "node scripts/ensure-generated-registry.mjs && node scripts/build-export-assets.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.9.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "0.25.12",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@12.5.1"
}
